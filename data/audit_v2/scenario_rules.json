{
  "method": "Conservative cross-category scenario grouping by ordered rules plus fuzzy-question union; heuristic, not expert semantic clustering",
  "fuzzy_threshold": 0.78,
  "rules": [
    {
      "scenario": "electrical_shock",
      "pattern": "током|тока|щипл|щиплет|пощип|б[ьь]ёт|бьется|бьётся|зазем|фаз[ауые]|\\bнол[ььяю]|\\bнул[ьяюе]"
    },
    {
      "scenario": "gas_emergency",
      "pattern": "(?:запах|пахнет|утечк|шипит).*(?:газ|плит|духов|баллон)|(?:газ|баллон).*(?:запах|пахнет|утечк|шипит)|угарн|углерод|угар|co2|\\bco\\b"
    },
    {
      "scenario": "gas_service",
      "pattern": "газ|конфорк|жикл|фитил|дымоход|тяга|колонк|кот[её]л|баллон|термопар"
    },
    {
      "scenario": "structural_openings",
      "pattern": "несущ|снос|снест|снести|перепланиров|про[её]м|капитальн.*стен|трещин|обруш|антресол|перекрыти"
    },
    {
      "scenario": "balcony_works",
      "pattern": "балкон|лоджи|парапет|фасад|крыша|чердак"
    },
    {
      "scenario": "heavy_fixings",
      "pattern": "тяж[её]л|шкаф.*(?:повес|веш|креп)|полк.*(?:стен|креп)|(?:стен|креп).*полк|гипсокартон|пеноблок|газобетон|дюбел|анкер"
    },
    {
      "scenario": "heating",
      "pattern": "отоплен|батаре|радиатор|маевск|теплоснабж|полотенцесуш|теплонос|т[её]пл.*пол"
    },
    {
      "scenario": "floods",
      "pattern": "залил|залив|затоп|потоп|прорв|прорыв|фонтан|кипяток|капает.*потол|потол.*капает"
    },
    {
      "scenario": "water_supply",
      "pattern": "смесител|подводк|шланг|\\bкран|водопровод|труб|напор|давлен|ржав.*вод|горяч.*вод|вод.*горяч|бойлер|водонагрев|сч[её]тчик.*вод|вод.*сч[её]тчик"
    },
    {
      "scenario": "drains",
      "pattern": "канализац|засор|забил|сифон|унитаз|бачок|слив|гофр"
    },
    {
      "scenario": "water_filters",
      "pattern": "фильтр.*(?:вод|кувшин|пить)|(?:вод|кувшин|пить).*фильтр|осмос|аэратор"
    },
    {
      "scenario": "electric_supply",
      "pattern": "электр|провод|розет|выключател|удлинител|автомат|узо|дифавтомат|щит|вилка|искр|гари|горел|сч[её]тчик|напряжен|коротк.*замык"
    },
    {
      "scenario": "lighting",
      "pattern": "люстр|светильник|ламп|светодиод|подсветк|освещен"
    },
    {
      "scenario": "window_glazing",
      "pattern": "стеклопак|ст[её]кл|остеклен"
    },
    {
      "scenario": "window_hardware",
      "pattern": "окн|створк|уплотн|цапф|подокон|откос|фурнитур"
    },
    {
      "scenario": "door_hardware",
      "pattern": "двер|петл|замок|замка|скважин|ручк|доводчик"
    },
    {
      "scenario": "walls_and_paint",
      "pattern": "шпакл|шпатл|обо[ийя]|крас[ик]|краск|покрас|побел|штукатур|потолок"
    },
    {
      "scenario": "tile_and_sealant",
      "pattern": "плитк|затирк|герметик|шов|швы|кафел"
    },
    {
      "scenario": "floors",
      "pattern": "ламинат|паркет|линолеум|плинтус|полов|дос[кч]|стяжк"
    },
    {
      "scenario": "cleaning",
      "pattern": "плесен|плесень|сырост|мыть|отмыть|чист|нал[её]т|очист|накип|запах|хлор|моющ"
    },
    {
      "scenario": "laundry",
      "pattern": "стирал|стираль|стирк|машинк|барабан|пуховик|кроссов|бель[её]|полоскан"
    },
    {
      "scenario": "dishwashing",
      "pattern": "посудомо|посудомой|посуд|бокал|соль|ополаск"
    },
    {
      "scenario": "refrigeration",
      "pattern": "холодильник|морозил|мороз|размороз|свежест"
    },
    {
      "scenario": "cooking_appliances",
      "pattern": "духов|вароч|конвекц|индукцион|микроволн|свч"
    },
    {
      "scenario": "coffee",
      "pattern": "кофе|кофей|кофем|капучин|завароч"
    },
    {
      "scenario": "climate",
      "pattern": "обогрев|конвектор|маслян|маслян|кондиционер|вытяжк|вентиляц|сушил"
    },
    {
      "scenario": "vacuum_cleaning",
      "pattern": "пылесос|насадк|шерст|шерсть"
    },
    {
      "scenario": "electronics",
      "pattern": "телевизор|wi.?fi|вай.?фай|антенн|роутер"
    },
    {
      "scenario": "rental",
      "pattern": "аренд|найм|снимаю|съехать|съез|высел|залог|собственник.*пуска|хозяин"
    },
    {
      "scenario": "property_transactions",
      "pattern": "покуп|прода|продаж|застройщик|егрн|задаток|аванс|дол[яию]|вычет|новостро"
    },
    {
      "scenario": "neighbours",
      "pattern": "сосед|шум|курят|курени|собак|полици"
    },
    {
      "scenario": "housing_finance",
      "pattern": "квитанц|начисл|оплат|платеж|плат[ыау]|коммунал|тариф|долг|субсид|льгот|перерасч|пен[ия]|судебн"
    },
    {
      "scenario": "housing_management",
      "pattern": "управляющ|\\bук\\b|тсж|собрани|протокол|гжи|жилинспекц|содержан|домофон|лифт|мусор"
    }
  ]
}
